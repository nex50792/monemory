# Playwright E2E テスト用の認証情報
# 
# 使用方法:
# 1. このファイルをコピーして .env.e2e を作成してください
#    cp .env.e2e.example .env.e2e
# 2. 下記の値をテスト用のClerkアカウント情報に置き換えてください
# 3. .env.e2e は自動的に .gitignore に含まれています（.env* ワイルドカード）
#
# 重要:
# - テスト用の専用アカウントを作成してください（本番アカウントではなく）
# - 認証情報は絶対にコミットしないでください
# - CI環境ではGitHub Actions Secretsを使用してください

# Clerkのテストユーザーメールアドレス
TEST_USER_EMAIL=test-user@example.com

# Clerkのテストユーザーパスワード
TEST_USER_PASSWORD=secure-test-password-123
